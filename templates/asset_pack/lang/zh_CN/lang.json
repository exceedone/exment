                {
                    "column_name": "result",
                    "column_view_name": "结果",
                    "options": {
                        "select_item_valtext": "found,已确认\nmissing,缺失\ndamaged,损坏"
                    }
                },
                {
                    "column_name": "location_found",
                    "column_view_name": "发现地点"
                },
                {
                    "column_name": "note",
                    "column_view_name": "备注"
                }
            ]
        },
        {
            "table_name": "asset_lending",
            "table_view_name": "借用",
            "description": "资产的借出与归还。",
